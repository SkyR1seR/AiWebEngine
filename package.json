{
  "name": "aiwebengine",
  "version": "0.1.0",
  "description": "Tiny WebGPU/WebGL2 3D engine for web games: rendering, physics, animation, effects, adaptive UI",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./physics": "./src/physics/index.ts",
    "./fx": "./src/fx/index.ts",
    "./ui": "./src/ui/index.ts",
    "./audio": "./src/audio/index.ts",
    "./debug": "./src/debug/index.ts",
    "./extras": "./src/extras/index.ts",
    "./assets": "./src/assets/index.ts",
    "./yandex": "./src/yandex/index.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "size": "node tools/size.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "new": "node tools/new-game.mjs",
    "analyze": "node tools/analyze.mjs",
    "export": "node tools/export.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@webgpu/types": "^0.1.60",
    "terser": "^5.36.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
